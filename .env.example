# =====================================================================
#  Copy this file to ".env.local" and fill in your keys.
#  NEVER commit your real keys — .env.local is git-ignored on purpose.
# =====================================================================

# --- Stripe (required to accept payments) ---
# Find these at https://dashboard.stripe.com/apikeys
# Use the TEST keys (sk_test_...) while trying things out, then swap to
# LIVE keys (sk_live_...) when you're ready to take real money.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Site URL (used for Stripe redirect links) ---
# Local preview: http://localhost:3000
# After deploying: your real domain, e.g. https://vivian.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email delivery (optional) ---
# The contact form works without this (messages are logged), but to
# actually receive emails, sign up free at https://resend.com and paste
# your API key here.
RESEND_API_KEY=
# The "from" address Resend sends as. Until you verify your own domain,
# you can use onboarding@resend.dev for testing.
CONTACT_FROM=onboarding@resend.dev
