# =====================================================================
#  Copy this file to ".env.local" for local testing, and add the same
#  variables in Vercel (Project → Settings → Environment Variables) for
#  the live site. NEVER commit real keys — .env.local is git-ignored.
# =====================================================================

# --- Admin panel password (REQUIRED for /admin) ---
# Pick something long and private. This unlocks your backend at /admin.
ADMIN_PASSWORD=change-me-to-a-long-secret

# --- Database: Upstash Redis (REQUIRED for live commissions/orders) ---
# Free. In Vercel: Storage tab → Upstash → it fills these in for you.
# Without these on the live site, orders/waitlist/tracking won't persist.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (REQUIRED to take payments) ---
# https://dashboard.stripe.com/apikeys
# Use sk_test_... to trial, sk_live_... for real money.
STRIPE_SECRET_KEY=

# --- Site URL (used for payment + tracking links) ---
# Local: http://localhost:3000   Live: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pet photo uploads: Vercel Blob (optional) ---
# In Vercel: Storage tab → create a Blob store → it auto-adds this token.
# Without it, the request form still works (people just can't attach photos).
BLOB_READ_WRITE_TOKEN=

# --- Live chat: Tawk.to (optional) ---
# tawk.to → Admin → Channels → Chat Widget → copy the embed "src"
# (https://embed.tawk.to/XXXX/YYYY). Paste it here to show the chat bubble.
NEXT_PUBLIC_TAWK_SRC=

# --- SMS texts to your phone via Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15551234567        # your Twilio number
OWNER_PHONE=+15559876543        # your cell — where texts arrive

# --- Email via Resend (optional) ---
RESEND_API_KEY=
CONTACT_FROM=onboarding@resend.dev
