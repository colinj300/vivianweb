# =====================================================================
#  Copy this file to ".env.local" and fill in your keys.
#  NEVER commit your real keys — .env.local is git-ignored on purpose.
#
#  The site fully runs WITHOUT any of these (preview mode): payments show
#  a friendly notice, texts/emails print to the terminal, and the
#  waitlist uses temporary in-memory storage. Add keys to turn each
#  feature on for real.
# =====================================================================

# --- Stripe (to send payment links / accept money) ---
# https://dashboard.stripe.com/apikeys  — use sk_test_... while testing.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Site URL (used for payment redirect links) ---
# Local: http://localhost:3000   After deploy: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMS texts to your phone (Twilio) ---
# Sign up at https://twilio.com, get a number, then fill these in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15551234567        # your Twilio phone number
OWNER_PHONE=+15559876543        # YOUR cell — where texts are sent

# --- Database for commissions + waitlist (Upstash Redis) ---
# Free, one-click from the Vercel dashboard (Storage tab) or upstash.com.
# Without these, the waitlist works in preview but resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard password (for the /admin page) ---
# Make this something long and private. Required to open /admin.
ADMIN_PASSWORD=change-me-to-something-secret

# --- Email copies of messages/requests (Resend, optional) ---
# https://resend.com — the contact form & requests work without it.
RESEND_API_KEY=
CONTACT_FROM=onboarding@resend.dev
